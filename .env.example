# ===== مزود الرسائل (Resala) لتأكيد OTP عبر SMS =====
# توكن الحساب من لوحة تحكم Resala — يأخذ قيمة من حسابك، لا تضعه هنا
RESALA_API_TOKEN=
# عنوان واجهة برمجة التطبيق (dev أو prod)
RESALA_BASE_URL=https://dev.resala.ly/api/v1
# اسم الخدمة الظاهر في الرسالة
RESALA_SERVICE_NAME=Sowair
# وضع الاختبار: true = لا تُرسل رسائل حقيقية ولا يُستهلك رصيد
RESALA_TEST_MODE=true
# طول رمز التحقق (4-6) — القديم 6
RESALA_PIN_LENGTH=6