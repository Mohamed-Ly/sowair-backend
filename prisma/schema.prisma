datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CUSTOMER
  DELIVERY
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String?        @unique // اختياري منذ التسجيل
  phone         String         @unique
  password      String
  role          Role           @default(CUSTOMER) // ✅ جديد
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  cart          Cart?
  Order         Order[]
  Wishlist      Wishlist?
  Notification  Notification[]
  DeviceToken   DeviceToken[]
  DeliveryAssignment DeliveryAssignment[] @relation("DeliveryAssignments")
  WalletTransaction WalletTransaction[] @relation("CourierWallet")
}

model Brand {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  slug       String       @unique
  country    String?
  image      String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  products   Product[]

  @@index([name])
}

// ============ الموردون وسعر الشراء ============
// costCents على الـ Variant (مش على الـ Product) لأن العطر 100مل أرخص من 200ml
model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]

  @@index([name])
  @@index([isActive])
}

model Category {
  id              Int               @id @default(autoincrement())
  name            String
  slug            String            @unique
  image           String?
  isActive        Boolean           @default(true)
  parentId        Int? // التصنيف الأب (للتصنيفات الهرمية: ملابس ← رجالي/نسائي...)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  parent          Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]        @relation("CategoryTree")

  products        Product[]
  ProductCategory ProductCategory[]

  @@index([name])
  @@index([parentId])
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  brandId     Int
  categoryId  Int // ✅ تصنيف واحد لكل منتج
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand           Brand             @relation(fields: [brandId], references: [id])
  category        Category          @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  ProductCategory ProductCategory[]
  ProductVariant  ProductVariant[]
  WishlistItem    WishlistItem[]

  @@index([brandId])
  @@index([categoryId])
  @@index([name])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  path      String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

// المتغيرات الخاصة بالمنتج (خيارات عامة تناسب أي نوع منتج) مع السعر/المخزون/الكود/الباركود
model ProductVariant {
  id            Int      @id @default(autoincrement())
  productId     Int
  option1       String? // خيار عام (المقاس L/XL، الحجم 100 مل، اللون أحمر...)
  option2       String? // خيار عام إضافي (اللون/التركيز/الطراز...)
  priceCents    Int // السعر بـالسنت/القرش (إلزامي >= 0)
  stockQty      Int      @default(0) // المخزون (>= 0)
  sku           String? // كود داخلي (اختياري)
  barcode       String? // باركود (اختياري)

  // سعر الشراء — null معناها لسه ما اتدخلش، وربح المنتجات دي ما يتحسبش في التقارير
  costCents     Int?
  supplierId    Int?

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product   Product     @relation(fields: [productId], references: [id])
  supplier  Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  CartItem  CartItem[]
  OrderItem OrderItem[]

  @@unique([productId, option1, option2]) // يمنع تكرار نفس (الخيارين) لنفس المنتج
  @@index([productId])
  @@index([sku])
  @@index([barcode])
}

model ProductCategory {
  productId  Int
  categoryId Int
  product    Product  @relation(fields: [productId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId]) // ✅ مفتاح مركّب + فريد
  @@index([categoryId])
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int?     @unique
  guestId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  variantId Int
  qty       Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId]) // كل Variant مرة واحدة داخل نفس السلة
  @@index([variantId])
}

enum OrderStatus {
  PENDING // قيد المراجعة
  CONFIRMED // مؤكد
  SHIPPING // قيد الشحن
  // تسليم جزئي: بعض البنود سُلّمت وبعضها رجع. لا يمكن اعتباره DELIVERED.
  PARTIALLY_DELIVERED // تم التسليم جزئياً
  DELIVERED // تم التسليم بالكامل
  CANCELLED // ملغي
}

model Order {
  id         Int         @id @default(autoincrement())
  userId     Int
  status     OrderStatus @default(PENDING)
  // الإجمالي النهائي اللي العميل دفعه فعلاً (بعد الخصم)
  totalCents Int
  // الإجمالي قبل الخصم + الخصم المطبّق (للتقارير و.calculate الربح)
  subtotalCents Int @default(0)
  discountCents Int @default(0)
  currency   String      @default("LYD")

  // معلومات الشحن (مدمجة مع الطلب كما طلبت)
  shippingName    String
  shippingPhone   String
  shippingAddress String // العنوان كامل كما هو

  // المدينة والمنطقة من قوائم ثابتة (عشان نعرف نوجّه المندوب الصح).
  // بنحفظ الـ ID والاسم مع بعض: الـ ID للربط والتقارير، والاسم snapshot
  // عشان يفضل صحيح حتى لو الأدمن غيّر اسم المنطقة أو حذفها بعد ما تتعمل طلبات.
  deliveryCityId   Int?
  deliveryAreaId   Int?
  deliveryCityName String?
  deliveryAreaName String?
  // رسوم التوصيل لحظة إنشاء الطلب (snapshot مثل الاسم). أساس محفظة المندوب:
  // لو الأدمن غيّر سعر المنطقة بكرة، محافظ الطلبات القديمة تشتغل برسومها الأصلية.
  deliveryFeeCents Int @default(0)

  cancelDeadline  DateTime? // آخر للإلغاء (24 ساعة) هاذا الوقت خاص بالمستخدم
  cancelledByUser Boolean   @default(false) // هل ألغاه المستخدم؟

  // ===== التسليم الجزئي (Phase 4) =====
  // المبالغ الثابتة بالقرش. collectedCents هو authoritative دايماً: الباج اند
  // يحسبه من البنود المسلّمة وما نثقش في رقم المندوب.
  collectedCents Int @default(0) // المبلغ اللي قبضه المندوب فعلياً (COD)
  returnReason   String? // سبب رجوع البنود (اختياري لو كلهم اتسلّموا)
  partiallyDeliveredAt DateTime? // وقت إنهاء التسليم الجزئي

  // ===== المخزون والـ stockDeducted =====
  // الخصم يتم عند CONFIRMED فقط (مش عند إنشاء الطلب). الحقل ده جواب سؤال
  // واحد: «هل اتخصم مخزون فعلي بسبب هذا الطلب ولا لا؟» — فعل تاريخي،
  // مش رصيد محجوز حالياً.
  //
  //   PENDING             -> false  (لسه ما اتخصمش)
  //   CONFIRMED           -> true   (اتخصم، والبضاعة لسه عندنا)
  //   SHIPPING            -> true   (اتخصم، والبضاعة في الطريق)
  //   DELIVERED           -> true   (اتخصم، والبضاعة وصلات للعميل)
  //   PARTIALLY_DELIVERED -> true   (اتخصم، جزء وصل والجزء الراجع رجع للمخزون)
  //   CANCELLED           -> false  (رجّعنا المخزون قبل ما نقفلو)
  //
  // ملاحظة مهمة: بعد التسليم الجزئي بيفضل true مع إن مفيش مخزون محجوز.
  // وده مقصود — الإلغاء ممنوع في الحالتين النهائيتين، فمفيش أي مسار
  // بيرجّع المخزون تاني (لو رجعنا «qty - returnedQty» كمان فمش هيتنفذ).
  // القيمة بتُقرأ كـ «إلغاء لازم يبدّلها false قبل ما يرجّع المخزون».
  stockDeducted Boolean @default(false)

  // التتبع
  orderNumber     String    @unique // رقم طلب مميز
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  cancelledAt     DateTime? // وقت الإلغاء
  cancelledReason String? // سبب الإلغاء

  // العلاقات
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]
  statusLogs OrderStatusLog[]
  DeliveryAssignment DeliveryAssignment?
  deliveryCity City? @relation("OrderDeliveryCity", fields: [deliveryCityId], references: [id], onDelete: SetNull)
  deliveryArea Area? @relation("OrderDeliveryArea", fields: [deliveryAreaId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([deliveryCityId])
  @@index([deliveryAreaId])
}

// ============ المدن والمناطق ============
// قوائم ثابتة يتحكم فيها الأدمن. العميل يختار منهم، والمندوب يوصّل حسب المنطقة.
model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  // كود ثابت مفيد للـ API وللربط مع خدمات أخرى لاحقاً (مثل خرائط جوجل)
  code      String?  @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  // رسوم التوصيل الافتراضية للمدينة (بالقرش). المنطقة تقدر تعمل لها override.
  deliveryFeeCents Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas  Area[]
  orders Order[] @relation("OrderDeliveryCity")

  @@index([isActive])
}

model Area {
  id        Int      @id @default(autoincrement())
  name      String
  cityId    Int
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  // رسوم التوصيل للمنطقة (بالقرش). null = نفس رسوم المدينة الافتراضية.
  deliveryFeeCents Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city   City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  orders Order[] @relation("OrderDeliveryArea")

  // ما ينفعش يكون في منطقتين بنفس الاسم داخل نفس المدينة
  @@unique([cityId, name])
  @@index([cityId])
  @@index([isActive])
}

// سجل حركة حالة الطلب (للتقارير والتتبع)
model OrderStatusLog {
  id        Int      @id @default(autoincrement())
  orderId   Int
  status    String // OrderStatus كنص للأمان (PENDING/CONFIRMED/SHIPPING/DELIVERED/CANCELLED)
  note      String?
  actorType String? // ADMIN / DELIVERY / SYSTEM / CUSTOMER
  actorId   Int?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

// تعيين طلب إلى مندوب توصيل
model DeliveryAssignment {
  id            Int       @id @default(autoincrement())
  orderId       Int       @unique
  deliveryId    Int
  status        String    @default("ASSIGNED") // ASSIGNED / ACCEPTED / DELIVERED / CANCELLED
  assignedAt    DateTime  @default(now())
  acceptedAt    DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  note          String?

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryUser User @relation("DeliveryAssignments", fields: [deliveryId], references: [id])

  @@index([deliveryId])
  @@index([status])
}

// ============ محفظة المندوب ============
// السجل المالي الوحيد لعمولة المندوب. الرصيد يُحسب من السجل:
//   balance = Σ amountCents  (EARNING و ADJUSTMENT موجبة/موقّعة، SETTLEMENT سالبة)
// EARNING تُضاف تلقائياً داخل settleDelivery (نفس الـ transaction = مرّة واحدة فقط
// لأن الطلب يُقفل نهائياً عند التسليم — مفيش تكرار محتمل أصلاً).
// SETTLEMENT تُسجَّل يدوياً من صفحة «إدارة المندوبين» عند سحب الأدمن للرصيد.
model WalletTransaction {
  id            Int      @id @default(autoincrement())
  courierId     Int
  type          String // EARNING / SETTLEMENT / ADJUSTMENT
  // EARNING و ADJUSTMENT موجبتان/موقّعتان، و SETTLEMENT سالبة دايماً
  amountCents   Int
  refType       String? // "ORDER" / null (تسوية/تعديل يدوي)
  refId         Int?
  orderNumber   String? // snapshot لسهولة القراءة في سجلات المحفظة
  deliveryFeeCents Int? // snapshot لرسوم التوصيل اللي ولّدت هذه العمولة
  method        String? // طريقة الصرف (نقدي/تحويل...) — للتسويات فقط
  note          String?
  createdAt     DateTime @default(now())

  courier User @relation("CourierWallet", fields: [courierId], references: [id])

  @@index([courierId])
  @@index([type])
  @@index([createdAt])
}

model OrderItem {
  id             Int @id @default(autoincrement())
  orderId        Int
  variantId      Int
  unitPriceCents Int // السعر للوحدة قبل الخصم
  qty            Int // الكمية

  // ===== التسليم الجزئي (Phase 4) =====
  // القاعدة الذهبية: deliveredQty + returnedQty <= qty دايماً.
  // default 0 يعني البند لسه ما اتسلّمش ولا رجع (لأن الطلب لسه PENDING/CONFIRMED).
  // بنحدّثهم مرة واحدة بس عند التسليم، فمافيش risk of double-return للمخزون.
  deliveredQty Int @default(0) // الكمية اللي اتسلّمت للعميل
  returnedQty  Int @default(0) // الكمية اللي رجعت للمخزون (رفض/نفدت)

  // صافي قيمة البند. discountCents بيفضل 0 دايماً: العروض دلوقتي
  // بانرات للعرض فقط وما بتخصمش حاجة. الحقل موجود عشان حسابات
  // صافي الربح والتسليم تكتب على نفس الحقل.
  discountCents  Int @default(0)
  lineTotalCents Int @default(0) // = unitPriceCents * qty

  // نسخة ثابتة من سعر الشراء لحظة إنشاء الطلب.
  // لازم تكون نسخة مشمرجع، لأن تعديل سعر الشراء بكرة ما يجبش يغيّر أرباح الشهور السابقة.
  // null = سعر الشراء ما كانش متدخل وقتها => ربح هذا البند غير معروف
  unitCostCents Int?

  // العلاقات
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int?     @unique // كل مستخدم لديه wishlist واحدة
  guestId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?          @relation(fields: [userId], references: [id])
  items WishlistItem[]
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  wishlistId Int
  productId  Int // نربط بالمنتج مباشرة (ليس بالـ variant)
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([wishlistId, productId]) // كل منتج مرة واحدة في الـ wishlist
  @@index([productId])
}

enum NotificationType {
  ORDER_CREATED // تم إنشاء طلب جديد
  ORDER_CONFIRMED // تم تأكيد الطلب
  ORDER_SHIPPED // تم شحن الطلب
  ORDER_DELIVERED // تم التسليم بالكامل
  ORDER_PARTIALLY_DELIVERED // تم التسليم جزئياً (بعض البنود رجعت)
  ORDER_CANCELLED // تم إلغاء الطلب
  LOW_STOCK // مخزون منخفض
  PROMOTIONAL // إشعار ترويجي
  SYSTEM // إشعار نظام
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int? // إذا كان null يعني إشعار عام لجميع المستخدمين
  type      NotificationType
  title     String
  body      String
  data      Json? // بيانات إضافية (مثل orderId, productId, إلخ)
  isRead    Boolean          @default(false)
  isPush    Boolean          @default(false) // إذا تم إرساله كـ push notification
  sentAt    DateTime? // وقت الإرسال الفعلي
  createdAt DateTime         @default(now())
  readAt    DateTime? // وقت القراءة

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int?
  token     String   @unique
  platform  String? // "android" | "ios" | "web"
  lang      String? // "ar" | "en" ...
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
}

// العرض = بانر للعرض فقط (صورة + عنوان + وصف + تواريخ).
// لا يوجد خصم على المنتجات: البانر إعلاني، ما بيأثرش على أي سعر.
model Offer {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  image       String? // صورة العرض للسلايدر

  // التواريخ
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  // التتبع
  clickCount   Int      @default(0) // عدد النقرات على العرض
  displayOrder Int      @default(0) // ترتيب العرض في السلايدر
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([startDate, endDate])
  @@index([displayOrder])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ============ رموز التحقق OTP (مزود "رسالة") ============
// سجل مستقل عن User حتى لا يتأثر الحساب قبل اكتمال التحقق.
// لا نخزّن الرمز نصياً أبداً — نخزّن sha256(pinHash) فقط.
model OtpCode {
  id        Int      @id @default(autoincrement())
  phone     String
  purpose   String // REGISTER | RESET_PASSWORD
  pinHash   String // sha256(pin) — لا نخزّن الرمز نصياً
  expiresAt DateTime // الصلاحية (5 دقائق)
  attempts  Int      @default(0) // المحاولات الفاشلة (الحد 5)
  consumedAt DateTime? // وقت الاستهلاك الناجح
  createdAt DateTime  @default(now())
  // بيانات التسجيل المؤقتة (name/email/phone/passwordHash) — تُحمل عند
  // إعادة الإرسال حتى لا يضطر المستخدم لإعادة كتابة البيانات.
  metadata  Json?

  @@index([phone])
  @@index([phone, purpose])
  @@index([createdAt])
}
